    label.Font = Enum.Font.GothamBold
    label.TextXAlignment = Enum.TextXAlignment.Left
    label.Parent = parent
    return label
end

local packButtons = {}  -- untuk highlight pack aktif

local function createPackButton(packName, parent)
    local btn = Instance.new("TextButton")
    btn.Name = packName .. "Btn"
    btn.Size = UDim2.new(1, -10, 0, 36)
    btn.BackgroundColor3 = Color3.fromRGB(45, 45, 65)
    btn.BorderSizePixel = 0
    btn.Text = packName
    btn.TextColor3 = Color3.fromRGB(200, 200, 255)
    btn.TextSize = 13
    btn.Font = Enum.Font.GothamMedium
    btn.Parent = parent

    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(0, 6)
    corner.Parent = btn

    btn.MouseEnter:Connect(function()
        TweenService:Create(btn, TweenInfo.new(0.15), {
            BackgroundColor3 = Color3.fromRGB(65, 65, 95)
        }):Play()
    end)

    btn.MouseLeave:Connect(function()
        if currentPack ~= packName then
            TweenService:Create(btn, TweenInfo.new(0.15), {
                BackgroundColor3 = Color3.fromRGB(45, 45, 65)
            }):Play()
        end
    end)

    btn.MouseButton1Click:Connect(function()
        local success, message = applyAnimationPack(packName)

        -- Reset semua tombol
        for name, b in pairs(packButtons) do
            TweenService:Create(b, TweenInfo.new(0.2), {
                BackgroundColor3 = Color3.fromRGB(45, 45, 65)
            }):Play()
        end

        if success then
            TweenService:Create(btn, TweenInfo.new(0.2), {
                BackgroundColor3 = Color3.fromRGB(50, 180, 80)
            }):Play()
        else
            TweenService:Create(btn, TweenInfo.new(0.2), {
                BackgroundColor3 = Color3.fromRGB(180, 50, 50)
            }):Play()
            task.wait(0.6)
            TweenService:Create(btn, TweenInfo.new(0.3), {
                BackgroundColor3 = Color3.fromRGB(45, 45, 65)
            }):Play()
        end

        print(message)
    end)

    packButtons[packName] = btn
    return btn
end

