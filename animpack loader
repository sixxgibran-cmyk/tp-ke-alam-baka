-- ============================================================
-- BAGIAN 2: STATE & PENERAPAN ANIMASI (PERSISTEN)
-- ============================================================

-- State global: menyimpan pack yang sedang aktif & flag respawn
local currentPack = nil          -- nama pack yang aktif
local isApplying = false         -- mencegah race-condition saat respawn

-- Terapkan animasi ke karakter tertentu
-- Fungsi ini dipisah dari state agar bisa dipakai berulang
local function applyPackToCharacter(packName, character)
    local pack = AnimationPacks[packName]
    if not pack then return false, "Pack tidak ditemukan!" end
    if not character then return false, "Karakter tidak ditemukan!" end

    local humanoid = character:FindFirstChildOfClass("Humanoid")
    local animateScript = character:FindFirstChild("Animate")

    if not humanoid or not animateScript then
        return false, "Komponen Animate belum siap!"
    end

    local ok, err = pcall(function()
        -- Idle (2 variasi)
        if animateScript.idle then
            if animateScript.idle:FindFirstChild("Animation1") then
                animateScript.idle.Animation1.AnimationId = pack.Idle1
            end
            if animateScript.idle:FindFirstChild("Animation2") then
                animateScript.idle.Animation2.AnimationId = pack.Idle2
            end
        end

        -- Walk
        if animateScript.walk and animateScript.walk:FindFirstChild("WalkAnim") then
            animateScript.walk.WalkAnim.AnimationId = pack.Walk
        end

        -- Run
        if animateScript.run and animateScript.run:FindFirstChild("RunAnim") then
            animateScript.run.RunAnim.AnimationId = pack.Run
        end

        -- Jump
        if animateScript.jump and animateScript.jump:FindFirstChild("JumpAnim") then
            animateScript.jump.JumpAnim.AnimationId = pack.Jump
        end

        -- Fall
        if animateScript.fall and animateScript.fall:FindFirstChild("FallAnim") then
            animateScript.fall.FallAnim.AnimationId = pack.Fall
        end

        -- Swim
        if animateScript.swim and animateScript.swim:FindFirstChild("Swim") then
            animateScript.swim.Swim.AnimationId = pack.Swim
        end

        -- SwimIdle
        if animateScript.swimidle and animateScript.swimidle:FindFirstChild("SwimIdle") then
            animateScript.swimidle.SwimIdle.AnimationId = pack.SwimIdle
        end
    end)

    if ok then
        return true, "Animation pack '" .. packName .. "' diterapkan!"
    else
        return false, "Gagal: " .. tostring(err)
    end
end

-- Wrapper untuk menerapkan & menyimpan state
local function applyAnimationPack(packName)
    if isApplying then
        return false, "Sedang menerapkan, tunggu sebentar..."
    end
    isApplying = true

    local character = LocalPlayer.Character
    local ok, message = applyPackToCharacter(packName, character)

    if ok then
        currentPack = packName
        -- Simpan ke atribut agar bisa dibaca ulang
        pcall(function()
            LocalPlayer:SetAttribute("ActiveAnimPack", packName)
        end)
    end

    isApplying = false
    return ok, message
end

-- ============================================================
-- BAGIAN 3: RE-APPLY SETELAH RESPAWN (INTI PERSISTENSI)
-- ============================================================

-- Tunggu sampai Animate script benar-benar siap (bukan hanya ada,
-- tapi sudah ter-load childnya)
local function waitForAnimateReady(character, timeout)
    timeout = timeout or 10
    local startTime = tick()

    while tick() - startTime < timeout do
        local animate = character:FindFirstChild("Animate")
        if animate and animate:FindFirstChild("idle") 
           and animate.idle:FindFirstChild("Animation1")
           and animate:FindFirstChild("walk")
           and animate:FindFirstChild("run") then
            return animate
        end
        task.wait(0.1)
    end

    return character:FindFirstChild("Animate")
end

-- Handler saat karakter baru muncul
local function onCharacterAdded(character)
    -- Tunggu Humanoid
    local humanoid = character:WaitForChild("Humanoid", 10)
    if not humanoid then return end

    -- Tunggu sampai Animate script siap sepenuhnya
    waitForAnimateReady(character, 10)

    -- Beri jeda kecil agar game tidak menimpa animasi kita
    task.wait(0.3)

    -- Re-apply pack yang tersimpan
    local packToApply = currentPack or LocalPlayer:GetAttribute("ActiveAnimPack")
    if packToApply and AnimationPacks[packToApply] then
        currentPack = packToApply
        applyPackToCharacter(packToApply, character)
        print("🔄 Re-applied animation pack: " .. packToApply)
    end

    -- Pasang watchdog: pantau jika ada script lain menimpa animasi
    local lastPack = packToApply
    task.spawn(function()
        local checkCount = 0
        while checkCount < 30 and character.Parent do -- cek 30x (~15 detik)
            task.wait(0.5)
            checkCount += 1

            local pack = AnimationPacks[lastPack]
            local animate = character:FindFirstChild("Animate")
            if not pack or not animate then continue end

            -- Cek apakah WalkAnim masih pakai ID kita
            local walkAnim = animate:FindFirstChild("walk") 
                and animate.walk:FindFirstChild("WalkAnim")
            if walkAnim and walkAnim.AnimationId ~= pack.Walk then
                -- Ditimpa! Re-apply
                applyPackToCharacter(lastPack, character)
            end
        end
    end)
end

-- Sambungkan event
LocalPlayer.CharacterAdded:Connect(onCharacterAdded)

-- Jika karakter sudah ada saat script dijalankan, langsung apply
if LocalPlayer.Character then
    onCharacterAdded(LocalPlayer.Character)
end

