-- Bangun tabel animasi final (pack + override)
local function getFinalPack()
    local pack = {}

    -- Basis: dari pack yang aktif (kalau ada)
    if currentPack and AnimationPacks[currentPack] then
        for k, v in pairs(AnimationPacks[currentPack]) do
            pack[k] = v
        end
    else
        -- Default fallback
        for k, v in pairs(AnimationPacks["Default"]) do
            pack[k] = v
        end
    end

    -- Timpa dengan custom override
    for k, v in pairs(customOverrides) do
        pack[k] = v
    end

    return pack
end

-- Terapkan ke karakter tertentu
local function applyPackToCharacter(pack, character)
    if not character then return false, "Karakter tidak ada" end
    if not pack then return false, "Pack kosong" end

    local humanoid = character:FindFirstChildOfClass("Humanoid")
    local animate  = character:FindFirstChild("Animate")

    if not humanoid or not animate then
        return false, "Animate belum siap"
    end

    local ok, err = pcall(function()
        if animate:FindFirstChild("idle") then
            local idle = animate.idle
            if idle:FindFirstChild("Animation1") then
                idle.Animation1.AnimationId = pack.Idle1 or ""
            end
            if idle:FindFirstChild("Animation2") then
                idle.Animation2.AnimationId = pack.Idle2 or ""
            end
        end

        if animate:FindFirstChild("walk") 
           and animate.walk:FindFirstChild("WalkAnim") then
            animate.walk.WalkAnim.AnimationId = pack.Walk or ""
        end

        if animate:FindFirstChild("run") 
           and animate.run:FindFirstChild("RunAnim") then
            animate.run.RunAnim.AnimationId = pack.Run or ""
        end

        if animate:FindFirstChild("jump") 
           and animate.jump:FindFirstChild("JumpAnim") then
            animate.jump.JumpAnim.AnimationId = pack.Jump or ""
        end

        if animate:FindFirstChild("fall") 
           and animate.fall:FindFirstChild("FallAnim") then
            animate.fall.FallAnim.AnimationId = pack.Fall or ""
        end

        if animate:FindFirstChild("swim") 
           and animate.swim:FindFirstChild("Swim") then
            animate.swim.Swim.AnimationId = pack.Swim or ""
        end

        if animate:FindFirstChild("swimidle") 
           and animate.swimidle:FindFirstChild("SwimIdle") then
            animate.swimidle.SwimIdle.AnimationId = pack.SwimIdle or ""
        end
    end)

    if ok then
        return true, "OK"
    else
        return false, tostring(err)
    end
end

-- Wrapper publik: apply ke karakter saat ini
local function applyCurrentConfig()
    if isApplying then return false, "Sedang apply" end
    isApplying = true

    local character = LocalPlayer.Character
    local pack = getFinalPack()
    local ok, msg = applyPackToCharacter(pack, character)

    isApplying = false
    return ok, msg
end

-- Set pack (dari UI)
local function selectPack(packName)
    if not AnimationPacks[packName] then
        return false, "Pack tidak ditemukan"
    end
    currentPack = packName
    return applyCurrentConfig()
end

